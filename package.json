{
  "name": "danish-fitness",
  "private": true,
  "version": "1.0.0",
  "description": "Danish Fitness — offline-first gym management desktop app (Model Town B, Khanpur, Rahim Yar Khan)",
  "author": "Fahad Baloch",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "bindings": "cargo test -p danish-core --lib export_bindings && node scripts/gen-bindings-index.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "e2e": "node e2e/smoke.mjs",
    "docs:pdf": "node scripts/guide-pdf.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-log": "2.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-is": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "marked": "18.0.14",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
